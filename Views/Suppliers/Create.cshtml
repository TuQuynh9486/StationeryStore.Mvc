@model SupplierCreateViewModel

<h2>Create Supplier</h2>

<form asp-action="Create">

    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Phone</label>
        <input asp-for="Phone" />
    </div>

    <button type="submit">
        Save
    </button>

</form>
@model StationeryDetailViewModel

<h2>Xác nhận xóa</h2>

<p>
    Bạn có chắc muốn xóa sản phẩm:
    <strong>@Model.Name</strong> ?
</p>

<form asp-action="DeleteConfirmed"
      method="post">

    <input type="hidden"
           name="id"
           value="@Model.Id" />

    @Html.AntiForgeryToken()

    <button type="submit"
            class="btn btn-danger">
        Xóa
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Hủy
    </a>
</form>
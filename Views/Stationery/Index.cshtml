@model List<StationeryListItemViewModel>

@{
    ViewData["Title"] = "Stationery Catalog";

    var totalItems = Model.Count;
}

<div class="page-header">

    <div>

        <h2 class="page-title">
            Stationery Catalog
        </h2>

        <p class="page-description">
            Danh sách các sản phẩm văn phòng phẩm
            của cửa hàng được hiển thị bằng Partial View.
        </p>

    </div>

    <div>

        <a class="btn btn-secondary" asp-controller="Stationery" asp-action="Search">
            Search
        </a>

        <a class="btn" asp-controller="Stationery" asp-action="Create">
            Create
        </a>

        <a class="btn btn-light" asp-controller="Stationery" asp-action="Stats">
            Inventory Stats
        </a>

        <a class="btn btn-danger" asp-controller="Stationery" asp-action="Trash">
            Trash
        </a>

    </div>

</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="success-box">
        @TempData["SuccessMessage"]
    </div>
}

<div class="info-box">

    <strong>Tổng số sản phẩm:</strong>
    @totalItems

</div>

@if (Model.Count == 0)
{
    <p>
        Chưa có sản phẩm nào trong hệ thống.
    </p>
}
else
{
    <div class="product-grid">

        @foreach (var item in Model)
        {
            <partial name="_StationeryCard" model="item" />
        }

    </div>
}
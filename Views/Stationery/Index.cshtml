@model List<StationeryStore.Mvc.ViewModels.StationeryListItemViewModel>

@{
    ViewData["Title"] = "Stationery Catalog";
    var totalItems = Model.Count;
}

<div class="page-header">

    <div>

        <h2 class="page-title">
            Stationery Catalog
        </h2>

        <p class="page-description">
            Danh sách sản phẩm văn phòng phẩm.
        </p>

    </div>

    <div class="d-flex gap-2">

        <a class="btn btn-danger"
           asp-controller="Stationery"
           asp-action="Search">
            Search
        </a>

        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-success"
               asp-controller="Stationery"
               asp-action="Create">
                Create
            </a>

            <a class="btn btn-danger"
               asp-controller="Stationery"
               asp-action="Trash">
                Trash
            </a>
        }

    </div>

</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-3">
        @TempData["ErrorMessage"]
    </div>
}

<div class="alert alert-info mt-3">

    <strong>Tổng số sản phẩm:</strong>
    @totalItems

</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="alert alert-light">

        Xin chào
        <strong>@User.Identity.Name</strong>

        @if (User.IsInRole("Admin"))
        {
            <span class="badge bg-danger ms-2">
                Admin
            </span>
        }
        else if (User.IsInRole("Staff"))
        {
            <span class="badge bg-primary ms-2">
                Staff
            </span>
        }
        else if (User.IsInRole("User"))
        {
            <span class="badge bg-secondary ms-2">
                User
            </span>
        }

    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-warning mt-4">
        Chưa có sản phẩm nào trong hệ thống.
    </div>
}
else
{
    <div class="product-grid">

        @foreach (var item in Model)
        {
            <partial name="_StationeryCard"
                     model="item" />
        }

    </div>
}
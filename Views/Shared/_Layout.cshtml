<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - StationeryStore.Mvc
    </title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header class="site-header">
        <div class="container header-content">

            <div class="brand">
                <a asp-controller="Home" asp-action="Index">
                    Stationery Store MVC
                </a>
            </div>

            <nav class="main-nav">

                <a asp-controller="Home" asp-action="Index">
                    Home
                </a>

                <a asp-controller="Stationery" asp-action="Index">
                    Products
                </a>

                <a asp-controller="Categories" asp-action="Index">
                    Categories
                </a>

                <a asp-controller="Suppliers" asp-action="Index">
                    Suppliers
                </a>

                @*

                <a asp-controller="Stationery" asp-action="Search">
                    Search
                </a>

                <a asp-controller="Stationery" asp-action="Create">
                    Create Product
                </a>

                <a asp-controller="Stationery" asp-action="Stats">
                    Inventory Stats
                </a>
                *@

                <!-- THÊM MỚI -->
                <a asp-controller="Inventory" asp-action="Create">
                    Inventory Transaction
                </a>

                <a asp-controller="Health" asp-action="Index">
                    Data Health
                </a>

                @*

                <a asp-controller="Home" asp-action="Privacy">
                    Privacy
                </a>
                *@


            </nav>

        </div>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-content">

            <span>
                &copy; 2026 - StationeryStore.Mvc
            </span>

            <a asp-controller="Home" asp-action="Privacy">
                Privacy Policy
            </a>

        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
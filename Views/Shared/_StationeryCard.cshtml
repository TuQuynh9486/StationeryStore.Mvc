@model StationeryStore.Mvc.ViewModels.StationeryListItemViewModel

<div class="product-card">

    <img src="@(!string.IsNullOrWhiteSpace(Model.ImageUrl)
                ? Model.ImageUrl
                : "/images/no-image.png")"
         alt="@Model.Name"
         class="product-image" />

    <h3>@Model.Name</h3>

    <p class="product-meta">
        <strong>Mã sản phẩm:</strong>
        @Model.Code
    </p>

    <p class="product-meta">
        <strong>Danh mục:</strong>
        @Model.Category
    </p>

    <p class="product-meta">
        <strong>Thương hiệu:</strong>
        @Model.Brand
    </p>

    <p class="product-price">
        @Model.PriceText
    </p>

    <p>
        <strong>Tồn kho:</strong>
        @Model.StockQuantity
    </p>

    @if (Model.StockStatus == "Còn hàng")
    {
        <span class="badge badge-success">
            @Model.StockStatus
        </span>
    }
    else if (Model.StockStatus == "Sắp hết hàng")
    {
        <span class="badge badge-warning">
            @Model.StockStatus
        </span>
    }
    else
    {
        <span class="badge badge-danger">
            @Model.StockStatus
        </span>
    }

    <hr />

    <div class="card-actions">

        <a class="btn btn-primary"
           asp-controller="Stationery"
           asp-action="Detail"
           asp-route-id="@Model.Id">
            Detail
        </a>

        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-warning"
               asp-controller="Stationery"
               asp-action="Edit"
               asp-route-id="@Model.Id">
                Edit
            </a>

            <a class="btn btn-info"
               asp-controller="Stationery"
               asp-action="AdjustStock"
               asp-route-id="@Model.Id">
                Adjust Stock
            </a>

            <a class="btn btn-danger"
               asp-controller="Stationery"
               asp-action="UploadImage"
               asp-route-id="@Model.Id">
                Upload Image
            </a>

            <a class="btn btn-danger"
               asp-controller="Stationery"
               asp-action="Delete"
               asp-route-id="@Model.Id">
                Delete
            </a>
        }

    </div>

</div>
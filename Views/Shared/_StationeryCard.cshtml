@model StationeryListItemViewModel

<div class="product-card">

    <img src="@Model.ImageUrl" alt="@Model.Name" class="product-image" />

    <h3>@Model.Name</h3>

    <p class="product-meta">
        Mã sản phẩm: @Model.Code
    </p>

    <p class="product-meta">
        Danh mục: @Model.Category
    </p>

    <p class="product-meta">
        Thương hiệu: @Model.Brand
    </p>

    <p class="product-price">
        @Model.PriceText
    </p>

    <p>
        Số lượng tồn kho:
        <strong>@Model.StockQuantity</strong>
    </p>

    @if (Model.StockStatus == "Còn hàng")
    {
        <span class="badge badge-success">
            @Model.StockStatus
        </span>
    }
    else if (Model.StockStatus == "Sắp hết hàng")
    {
        <span class="badge badge-warning">
            @Model.StockStatus
        </span>
    }
    else
    {
        <span class="badge badge-danger">
            @Model.StockStatus
        </span>
    }

    <div class="card-actions">
        <a class="btn btn-light" asp-controller="Stationery" asp-action="Detail" asp-route-id="@Model.Id">
            Detail
        </a>

        <a class="btn btn-light" asp-controller="Stationery" asp-action="Edit" asp-route-id="@Model.Id">
            Edit
        </a>

        <a class="btn btn-light" asp-controller="Stationery" asp-action="AdjustStock" asp-route-id="@Model.Id">
            Adjust Stock
        </a>

        <form asp-controller="Stationery" asp-action="Delete" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này không?');">

            @Html.AntiForgeryToken()

            <button type="submit" class="btn btn-light">
                Delete
            </button>

        </form>
    </div>
</div>